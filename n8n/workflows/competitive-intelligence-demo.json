    {
      "parameters": {"jsCode": "const b=$('Validate Output Bundle').first().json; const o=b.options; return [{json:{...b,maySendEmail:!o.dryRun&&o.sendEmail&&String(o.recipient||'').trim().length>0}}];"},
      "id": "email-gate-data",
      "name": "Build Email Preview",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3420, 20]
    },
    {
      "parameters": {"conditions": {"options": {"caseSensitive": true}, "conditions": [{"leftValue": "={{ $json.maySendEmail }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"}, "options": {}},
      "id": "email-gate",
      "name": "Email Enabled and Recipient Present",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [3640, 20]
    },
    {
      "parameters": {"sendTo": "={{ $json.options.recipient }}", "subject": "={{ $json.email_content.subject }}", "emailType": "html", "message": "={{ $json.email_content.html }}", "options": {}},
      "id": "send-email",
