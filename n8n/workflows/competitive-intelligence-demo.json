      "name": "Execute Python Demo Pipeline",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [-760, 0]
    },
    {
      "parameters": {
        "fileSelector": "/demo-output/demo_bundle.json",
        "options": {}
      },
      "id": "read-bundle",
      "name": "Read Demo Bundle",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [-540, 0]
    },
    {
      "parameters": {"operation": "fromJson", "options": {}},
      "id": "extract-bundle",
      "name": "Parse Demo Bundle",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [-320, 0]
    },
    {
      "parameters": {
        "jsCode": "const b=$json; const o=$('Select Demo Options').first().json; const required={stg_rows:['Item Number','Product Name','Vendor','Base Price','Final Price','Stock Status','Timestamp','SEQN'],ods_rows:['Item Number','Product Name','Vendor','Base Price','Final Price','Stock Status','Timestamp','SEQN'],tgt_rows:['Item Number','Product Name','Vendor','Base Price','Final Price','My price','Recent Stock','Current Stock','Timestamp'],comment_rows:['Product Name','Vendor','Pros1','Pros2','Pros3','Cons1','Cons2','Cons3','Summary'],overall_trend_rows:['Product Name','Vendor','Overall Trend','Observation'],recent_suggestion_rows:['Product Name','Vendor','Suggestion']}; if(!b.seqn||b.run_summary?.seqn!==b.seqn) throw new Error('Invalid bundle SEQN'); for(const [key,headers] of Object.entries(required)){if(!Array.isArray(b[key])) throw new Error(`Missing ${key}`); for(const row of b[key]) if(JSON.stringify(Object.keys(row))!==JSON.stringify(headers)) throw new Error(`Schema mismatch: ${key}`);} return [{json:{...b,options:o}}];"
      },
      "id": "validate-bundle",
      "name": "Validate Output Bundle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-100, 0]
    },
    {
      "parameters": {
        "conditions": {"options": {"caseSensitive": true}, "conditions": [{"leftValue": "={{ $json.options.dryRun || !$json.options.writeSheets }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"},
        "options": {}
      },
      "id": "dry-run-gate",
      "name": "Dry Run or Sheets Disabled",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [120, 0]
    },
    {
      "parameters": {
        "documentId": {"__rl": true, "mode": "url", "value": "={{ $json.options.sheetUrl }}"},
        "sheetName": {"__rl": true, "mode": "name", "value": "STG"},
        "options": {}
      },
      "id": "read-existing-seqn",
      "name": "Read Existing STG SEQN",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.6,
      "position": [340, 140]
    },
    {
      "parameters": {
        "jsCode": "const b=$('Validate Output Bundle').first().json; const duplicate=$input.all().some(i=>String(i.json.SEQN||'')===String(b.seqn)); if(duplicate) throw new Error(`Duplicate SEQN ${b.seqn}; no rows written`); return [{json:b}];"
      },
      "id": "duplicate-guard",
      "name": "Duplicate SEQN Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, 140]
    },
    {
      "parameters": {"jsCode": "return $('Validate Output Bundle').first().json.stg_rows.map(json=>({json}));"},
      "id": "prepare-stg",
