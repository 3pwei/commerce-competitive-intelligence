      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 140]
    },
    {
      "parameters": {"operation": "append", "documentId": {"__rl": true, "mode": "url", "value": "={{ $('Select Demo Options').first().json.sheetUrl }}"}, "sheetName": {"__rl": true, "mode": "name", "value": "STG"}, "columns": {"mappingMode": "autoMapInputData", "value": {}}, "options": {}},
