      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [-760, 0]
    },
    {
      "parameters": {
        "jsCode": "const b=$json.data; const o=$('Select Demo Options').first().json; const required={stg_rows:['Item Number','Product Name','Vendor','Base Price','Final Price','Stock Status','Timestamp','SEQN'],ods_rows:['Item Number','Product Name','Vendor','Base Price','Final Price','Stock Status','Timestamp','SEQN'],tgt_rows:['Item Number','Product Name','Vendor','Base Price','Final Price','My price','Recent Stock','Current Stock','Timestamp'],comment_rows:['Product Name','Vendor','Pros1','Pros2','Pros3','Cons1','Cons2','Cons3','Summary'],overall_trend_rows:['Product Name','Vendor','Overall Trend','Observation'],recent_suggestion_rows:['Product Name','Vendor','Suggestion']}; if(!b.seqn||b.run_summary?.seqn!==b.seqn) throw new Error('Invalid bundle SEQN'); for(const [key,headers] of Object.entries(required)){if(!Array.isArray(b[key])) throw new Error(`Missing ${key}`); for(const row of b[key]) if(JSON.stringify(Object.keys(row))!==JSON.stringify(headers)) throw new Error(`Schema mismatch: ${key}`);} return [{json:{...b,options:o}}];"
      },
      "id": "validate-bundle",
      "name": "Validate Output Bundle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-100, 0]
    },
    {
      "parameters": {
        "conditions": {"options": {"caseSensitive": true}, "conditions": [{"leftValue": "={{ $json.options.dryRun || !$json.options.writeSheets }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"},
        "options": {}
      },
