      "name": "Select Demo Options",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-980, 0]
    },
    {
      "parameters": {
        "command": "cd /opt/competitive-intelligence && python3 -m competitive_intelligence demo-run --mode fixture --provider mock --output-dir /demo-output"
      },
