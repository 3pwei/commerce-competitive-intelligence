    },
    {
      "parameters": {"jsCode": "const b=$('Validate Output Bundle').first().json; return [{json:{status:'completed',executionId:$execution.id,dryRun:b.options.dryRun,seqn:b.seqn,sheetRows:b.run_summary.sheet_row_counts,eventCount:b.run_summary.detected_event_count,emailPreviewPath:'/demo-output/email_preview.html',emailPreview:b.email_content,emailSent:!b.options.dryRun&&b.options.sendEmail&&String(b.options.recipient||'').trim().length>0}}];"},
